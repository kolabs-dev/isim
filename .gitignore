# Build products (reproducible via the build.sh / probe.sh scripts)
build/
experiments/*/out/
isim/out/
isim/**/out/
*.o

# Third-party downloads and source clones used for evaluation (not redistributed here;
# see experiments/04-darling for the pinned commits/URLs and fetch scripts)
experiments/04-darling/dl/
experiments/04-darling/src/

# Never commit signing material or API credentials
*.p8
*.p12
*.mobileprovision
*.cer
*.key
.env

# Pinned third-party source checkouts (see isim/swift/fetch-sources.sh)
third_party/
__pycache__/

# release packages (published on GitHub Releases)
isim/dist/
