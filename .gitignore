# Build products (reproducible via the build.sh scripts)
isim/out/
isim/**/out/
*.o

# Never commit signing material or API credentials
*.p8
*.p12
*.mobileprovision
*.cer
*.key
.env

# Pinned third-party source checkouts (see isim/swift/fetch-sources.sh)
third_party/
__pycache__/

# release packages (published on GitHub Releases)
isim/dist/
