# A crystal (an octahedron) for HelloRealityKit: Wavefront OBJ with a material library, texture coordinates and
# normals left out (SceneKit's loader computes them).
mtllib crystal.mtl
o Crystal
v 0 1 0
v 0.6 0 0
v 0 0 0.6
v -0.6 0 0
v 0 0 -0.6
v 0 -1 0
vt 0.5 1
vt 1 0.5
vt 0.5 0
vt 0 0.5
usemtl Amethyst
f 1/1 3/4 2/3
f 1/1 4/4 3/3
f 1/1 5/4 4/3
f 1/1 2/4 5/3
usemtl Quartz
f 6/1 2/2 3/3
f 6/1 3/2 4/3
f 6/1 4/2 5/3
f 6/1 5/2 2/3
