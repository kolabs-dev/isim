---
# isim Foundation API notes (self-authored). Like Apple's, they tell Swift's Clang importer which
# Foundation classes bridge to Swift value types.
Name: Foundation
Classes:
- Name: NSString
  SwiftBridge: Swift.String
- Name: NSArray
  SwiftBridge: Swift.Array
- Name: NSDictionary
  SwiftBridge: Swift.Dictionary
- Name: NSBundle
  SwiftName: Bundle
- Name: NSProcessInfo
  SwiftName: ProcessInfo
- Name: NSNotificationCenter
  SwiftName: NotificationCenter
- Name: NSRunLoop
  SwiftName: RunLoop
- Name: NSTimer
  SwiftName: Timer
- Name: NSUserDefaults
  SwiftName: UserDefaults
  Methods:
  - Selector: 'setObject:forKey:'
    MethodKind: Instance
    SwiftName: 'set(_:forKey:)'
  - Selector: 'setInteger:forKey:'
    MethodKind: Instance
    SwiftName: 'set(_:forKey:)'
  - Selector: 'setBool:forKey:'
    MethodKind: Instance
    SwiftName: 'set(_:forKey:)'
  - Selector: 'setDouble:forKey:'
    MethodKind: Instance
    SwiftName: 'set(_:forKey:)'
- Name: NSSet
  SwiftBridge: Swift.Set
- Name: NSDateFormatter
  SwiftName: DateFormatter
- Name: NSNumberFormatter
  SwiftName: NumberFormatter
- Name: NSFormatter
  SwiftName: Formatter
- Name: NSISO8601DateFormatter
  SwiftName: ISO8601DateFormatter
- Name: NSRelativeDateTimeFormatter
  SwiftName: RelativeDateTimeFormatter
- Name: NSDateComponentsFormatter
  SwiftName: DateComponentsFormatter
- Name: NSDateIntervalFormatter
  SwiftName: DateIntervalFormatter
- Name: NSByteCountFormatter
  SwiftName: ByteCountFormatter
- Name: NSListFormatter
  SwiftName: ListFormatter
- Name: NSPersonNameComponentsFormatter
  SwiftName: PersonNameComponentsFormatter
- Name: NSMeasurementFormatter
  SwiftName: MeasurementFormatter
- Name: NSPersonNameComponents
  SwiftBridge: Foundation.PersonNameComponents
- Name: NSCalendar
  SwiftBridge: Foundation.Calendar
- Name: NSIndexSet
  SwiftBridge: Foundation.IndexSet
- Name: NSDateComponents
  SwiftBridge: Foundation.DateComponents
- Name: NSURL
  SwiftBridge: Foundation.URL
- Name: NSLocale
  SwiftBridge: Foundation.Locale
- Name: NSDate
  SwiftBridge: Foundation.Date
- Name: NSTimeZone
  SwiftBridge: Foundation.TimeZone
- Name: NSFileManager
  SwiftName: FileManager
  Methods:
  - Selector: 'URLsForDirectory:inDomains:'
    MethodKind: Instance
    SwiftName: 'urls(for:in:)'
- Name: NSThread
  SwiftName: Thread
- Name: NSOperationQueue
  SwiftName: OperationQueue
  Properties:
  - Name: mainQueue
    PropertyKind: Class
    SwiftName: main
  - Name: currentQueue
    PropertyKind: Class
    SwiftName: current
- Name: NSCharacterSet
  SwiftName: NSCharacterSet
- Name: NSMutableCharacterSet
  SwiftName: NSMutableCharacterSet
Typedefs:
- Name: NSRunLoopMode
  SwiftName: RunLoop.Mode
- Name: NSNotificationName
  SwiftName: NSNotification.Name
Globals:
- Name: NSDefaultRunLoopMode
  SwiftName: default
- Name: NSRunLoopCommonModes
  SwiftName: common
Tags:
- Name: NSComparisonResult
  SwiftName: ComparisonResult
- Name: NSSearchPathDirectory
  SwiftName: FileManager.SearchPathDirectory
- Name: NSSearchPathDomainMask
  SwiftName: FileManager.SearchPathDomainMask
