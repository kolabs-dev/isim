---
# isim Foundation API notes (self-authored). Like Apple's, they tell Swift's Clang importer which
# Foundation classes bridge to Swift value types.
Name: Foundation
Classes:
- Name: NSString
  SwiftBridge: Swift.String
- Name: NSArray
  SwiftBridge: Swift.Array
- Name: NSDictionary
  SwiftBridge: Swift.Dictionary
- Name: NSError
  SwiftBridge: Swift.Error
- Name: NSBundle
  SwiftName: Bundle
- Name: NSProcessInfo
  SwiftName: ProcessInfo
- Name: NSNotificationCenter
  SwiftName: NotificationCenter
- Name: NSRunLoop
  SwiftName: RunLoop
- Name: NSTimer
  SwiftName: Timer
- Name: NSUserDefaults
  SwiftName: UserDefaults
  Methods:
  - Selector: 'setObject:forKey:'
    MethodKind: Instance
    SwiftName: 'set(_:forKey:)'
  - Selector: 'setInteger:forKey:'
    MethodKind: Instance
    SwiftName: 'set(_:forKey:)'
  - Selector: 'setBool:forKey:'
    MethodKind: Instance
    SwiftName: 'set(_:forKey:)'
  - Selector: 'setDouble:forKey:'
    MethodKind: Instance
    SwiftName: 'set(_:forKey:)'
- Name: NSSet
  SwiftBridge: Swift.Set
- Name: NSDateFormatter
  SwiftName: DateFormatter
- Name: NSNumberFormatter
  SwiftName: NumberFormatter
- Name: NSFormatter
  SwiftName: Formatter
- Name: NSISO8601DateFormatter
  SwiftName: ISO8601DateFormatter
- Name: NSRelativeDateTimeFormatter
  SwiftName: RelativeDateTimeFormatter
- Name: NSDateComponentsFormatter
  SwiftName: DateComponentsFormatter
- Name: NSDateIntervalFormatter
  SwiftName: DateIntervalFormatter
- Name: NSByteCountFormatter
  SwiftName: ByteCountFormatter
- Name: NSListFormatter
  SwiftName: ListFormatter
- Name: NSPersonNameComponentsFormatter
  SwiftName: PersonNameComponentsFormatter
- Name: NSMeasurementFormatter
  SwiftName: MeasurementFormatter
- Name: NSPersonNameComponents
  SwiftBridge: Foundation.PersonNameComponents
- Name: NSCalendar
  SwiftBridge: Foundation.Calendar
- Name: NSIndexSet
  SwiftBridge: Foundation.IndexSet
- Name: NSData
  SwiftBridge: Foundation.Data
- Name: NSUUID
  SwiftBridge: Foundation.UUID
- Name: NSUndoManager
  SwiftName: UndoManager
- Name: NSFileHandle
  SwiftName: FileHandle
- Name: NSFileWrapper
  SwiftName: FileWrapper
- Name: NSScanner
  SwiftName: Scanner
- Name: NSProgress
  SwiftName: Progress
- Name: NSPropertyListSerialization
  SwiftName: PropertyListSerialization
- Name: NSDateComponents
  SwiftBridge: Foundation.DateComponents
- Name: NSURL
  SwiftBridge: Foundation.URL
- Name: NSIndexPath
  SwiftBridge: Foundation.IndexPath
- Name: NSLocale
  SwiftBridge: Foundation.Locale
- Name: NSDate
  SwiftBridge: Foundation.Date
- Name: NSTimeZone
  SwiftBridge: Foundation.TimeZone
- Name: NSFileManager
  SwiftName: FileManager
  Methods:
  - Selector: 'URLsForDirectory:inDomains:'
    MethodKind: Instance
    SwiftName: 'urls(for:in:)'
  - Selector: 'attributesOfItemAtPath:error:'
    MethodKind: Instance
    SwiftName: 'attributesOfItem(atPath:)'
  - Selector: 'setAttributes:ofItemAtPath:error:'
    MethodKind: Instance
    SwiftName: 'setAttributes(_:ofItemAtPath:)'
  - Selector: 'attributesOfFileSystemForPath:error:'
    MethodKind: Instance
    SwiftName: 'attributesOfFileSystem(forPath:)'
- Name: NSDirectoryEnumerator
  SwiftName: FileManager.DirectoryEnumerator
- Name: NSThread
  SwiftName: Thread
- Name: NSOperation
  SwiftName: Operation
- Name: NSBlockOperation
  SwiftName: BlockOperation
- Name: NSPort
  SwiftName: Port
- Name: NSMachPort
  SwiftName: NSMachPort
- Name: NSOperationQueue
  SwiftName: OperationQueue
  Methods:
  - Selector: 'addOperationWithBlock:'
    MethodKind: Instance
    SwiftName: 'addOperation(_:)'
  Properties:
  - Name: mainQueue
    PropertyKind: Class
    SwiftName: main
  - Name: currentQueue
    PropertyKind: Class
    SwiftName: current
- Name: NSCharacterSet
  SwiftName: NSCharacterSet
- Name: NSMutableCharacterSet
  SwiftName: NSMutableCharacterSet
Typedefs:
- Name: NSRunLoopMode
  SwiftName: RunLoop.Mode
- Name: NSNotificationName
  SwiftName: NSNotification.Name
Globals:
- Name: NSDefaultRunLoopMode
  SwiftName: default
- Name: NSRunLoopCommonModes
  SwiftName: common
Tags:
- Name: NSQualityOfService
  SwiftName: QualityOfService
- Name: NSOperationQueuePriority
  SwiftName: Operation.QueuePriority
- Name: NSComparisonResult
  SwiftName: ComparisonResult
- Name: NSSearchPathDirectory
  SwiftName: FileManager.SearchPathDirectory
- Name: NSSearchPathDomainMask
  SwiftName: FileManager.SearchPathDomainMask
- Name: NSDirectoryEnumerationOptions
  SwiftName: FileManager.DirectoryEnumerationOptions
- Name: NSFileManagerItemReplacementOptions
  SwiftName: FileManager.ItemReplacementOptions
