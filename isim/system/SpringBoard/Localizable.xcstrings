    "Deleting this app will also delete its data.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي حذف هذا التطبيق إلى حذف بياناته أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diese App löschst, werden auch ihre Daten gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar esta app también se eliminarán sus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de cette app supprimera également ses données."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת היישום תמחק גם את הנתונים שלו."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminando questa app verranno eliminati anche i suoi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリを削除すると、そのデータも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱을 삭제하면 해당 데이터도 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je deze app verwijdert, worden ook de bijbehorende gegevens verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar este app também apagará os dados dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar esta app também apaga os respetivos dados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此 App 也将删除其数据。"
          }
        }
      }
    },
