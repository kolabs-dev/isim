          "stringUnit": {
            "state": "translated",
            "value": "في isim، يكون Game Center محليًا: تسجل الألعاب الدخول باسم هذا اللاعب، وتُحفظ النتائج والإنجازات على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf isim ist Game Center lokal: Spiele melden sich als dieser Spieler an, Bestenlisten-Punkte und Erfolge bleiben auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En isim, Game Center es local: los juegos inician sesión como este jugador y sus puntuaciones y logros se guardan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur isim, Game Center est local : les jeux se connectent avec ce joueur, et leurs scores et succès restent sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-isim, Game Center הוא מקומי: משחקים מתחברים בתור שחקן זה, והניקוד וההישגים נשמרים במכשיר זה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su isim, Game Center è locale: i giochi accedono come questo giocatore e punteggi e obiettivi restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "isimのGame Centerはローカルです。ゲームはこのプレーヤーとしてサインインし、スコアと達成項目はこのデバイスに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "isim의 Game Center는 로컬입니다. 게임은 이 플레이어로 로그인하며 점수와 성취 항목은 이 기기에 보관됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op isim is Game Center lokaal: games loggen in als deze speler en scores en prestaties blijven op dit apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No isim, o Game Center é local: os jogos iniciam sessão como este jogador, e as pontuações e conquistas ficam neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No isim, o Game Center é local: os jogos iniciam sessão como este jogador e as pontuações e conquistas ficam neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 isim 上，Game Center 是本地的：游戏以此玩家身份登录，排行榜分数和成就保存在此设备上。"
          }
        }
      }
    },
