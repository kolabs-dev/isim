    "isim does not grant keyboards Full Access (network and shared container access).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمنح isim لوحات المفاتيح الوصول الكامل (الوصول إلى الشبكة والحاوية المشتركة)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "isim gewährt Tastaturen keinen vollen Zugriff (Netzwerk und gemeinsamer Container)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "isim no concede acceso total a los teclados (acceso a la red y al contenedor compartido)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "isim n’accorde pas l’accès complet aux claviers (accès au réseau et au conteneur partagé)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "isim אינו מעניק למקלדות גישה מלאה (גישה לרשת ולמכל המשותף)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "isim non concede l’accesso completo alle tastiere (rete e contenitore condiviso)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "isimはキーボードにフルアクセス（ネットワークと共有コンテナへのアクセス）を許可しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "isim은 키보드에 전체 접근(네트워크 및 공유 컨테이너 접근)을 허용하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "isim geeft toetsenborden geen volledige toegang (netwerk en gedeelde container)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O isim não concede Acesso Total aos teclados (acesso à rede e ao contêiner compartilhado)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O isim não concede acesso total aos teclados (acesso à rede e ao contentor partilhado)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "isim 不会授予键盘完全访问权限（网络和共享容器访问）。"
          }
        }
      }
    },
    "isim emulates the iOS %@ API on Linux. It is not Apple's iOS.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحاكي isim واجهة برمجة iOS %@ على Linux. إنه ليس iOS من Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "isim emuliert die API von iOS %@ unter Linux. Es ist nicht Apples iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "isim emula la API de iOS %@ en Linux. No es el iOS de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "isim émule l’API d’iOS %@ sous Linux. Ce n’est pas l’iOS d’Apple."
          }
