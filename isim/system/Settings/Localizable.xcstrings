    "Apps and websites use the first language in this list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم التطبيقات ومواقع الويب أول لغة في هذه القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps und Websites verwenden die erste Sprache dieser Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps y los sitios web usan el primer idioma de esta lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps et les sites web utilisent la première langue de cette liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים ואתרים משתמשים בשפה הראשונה ברשימה זו."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App e siti web usano la prima lingua di questo elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリとWebサイトはこのリストの最初の言語を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 및 웹 사이트는 이 목록의 첫 번째 언어를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps en websites gebruiken de eerste taal in deze lijst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps e sites usam o primeiro idioma desta lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps e os sites usam o primeiro idioma desta lista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和网站会使用此列表中的第一种语言。"
          }
        }
      }
    },
