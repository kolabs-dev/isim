#!/usr/bin/env bash
# isim — iOS simulator for Linux (research prototype).
#   isim boot [device options]   start the simulated device on its home screen (installed apps + Settings)
#   isim install <App.app>...    install apps on the device (shown on the home screen)
#   isim uninstall <name|bundle id>   remove an installed app (and its data container)
#   isim apps                    list installed apps
#   isim reset                   erase the device: installed apps, app data and settings
#   isim run <App.app> [args...]: install, boot and open the app (headless or ISIM_STANDALONE=1: the app alone)
#     options: [--os 17|18|26|27] [--device iphonese|iphone13mini|iphone14|iphone15|iphone15plus|iphone15promax|iphone16pro|iphone16promax|iphone17|iphoneair|iphone17pro|iphone17promax|ipadmini|ipadair11|ipadpro11|ipadpro13] [--zoom N] [--dark] [--headless --script "..."]
#   isim cc  <clang args...>     compile/link for the isim iOS-simulator SDK (x86_64)
#   isim swiftc [-embedded] <swiftc args...>  compile Swift for the simulator (needs docker image swift:6.2)
#   ISIM_MIN_IOS=17.0            deployment target used by cc/swiftc (default 17.0)
#   isim build -project X.xcodeproj [-target T] [-configuration Debug]   build an Xcode project for isim
#   isim test -project X.xcodeproj -scheme S [-only-testing:T/C/m] [-resultBundlePath D]   build + run XCTest/XCUITest/Swift Testing
#   isim info <App.app|binary>   show Mach-O platform / dependencies
#   isim storekit <app> list|refund|expire|cancel|resume|billing-issue|resolve|clear ...   local StoreKit Transaction Manager
#   isim storekit certificate|offer-key   the device's StoreKit testing certificate and subscription offers key
#   isim gamecenter [<app>] players|friends|score|challenge|activity|saved-games|...   local Game Center network
#   isim openurl <URL> [--control FIFO]   open a URL (custom scheme or universal link) in the running device's foreground app
#   isim push [BUNDLE_ID] <payload.apns|->   send a remote notification payload (JSON with an "aps" dictionary; without
#                                BUNDLE_ID its "Simulator Target Bundle" key names the app), like `xcrun simctl push`
#   isim appleid <app> list|revoke|reset         local Sign in with Apple state (revoke = Stop Using Apple ID)
#   isim metrickit               deliver sample MetricKit payloads to running apps (Debug > Simulate MetricKit Payloads)
#   isim version                 print the isim version and the iOS versions it supports
#   isim devices                 list device presets with the iOS versions each can run
#   isim update [VERSION]        install the latest (or given) release and make it active (keeps the others)
#   isim versions · isim use VERSION   list installed releases · switch the active one
#   isim send COMMAND...         send script commands (docs/SCRIPTING.md) to the running device of this device data, e.g.
#                                isim send "tapid login; shot s.png"
#   isim open [device options] [FILE.apns]   the desktop launcher's entry point: bring the running device to the
#                                front, or boot one; an .apns file is sent as a push
#   isim desktop install|uninstall   add / remove isim Simulator in the desktop's app launcher (icon, .apns files)
#   device options: --os N --device NAME --zoom N --dark --headless --script "..." --control FIFO (live script commands, one per line); device data: ISIM_DATA (~/.local/share/isim)
#     Without --control, a device reads commands from a FIFO of its own ($XDG_RUNTIME_DIR/isim/), which isim send,
#     isim open and isim openurl find through the device data.
#   --os 17|18|26|27 (or a point release, e.g. 17.5; env ISIM_OS_VERSION): the iOS version the device runs (default 18).
#     The device data remembers it for later boots/runs. Like Xcode, a device needs an iOS at least as new as the one it
#     shipped with (iPhone 17 models: 26+): an explicit older --os is an error; otherwise the nearest valid one is used.
set -euo pipefail
BIN=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
ISIM_INSTALL_DIR=${ISIM_INSTALL_DIR:-$HOME/.local/lib/isim}    # installed releases (install.sh / isim update)
# a copy of this script outside a release (e.g. cp'd into ~/bin) uses the active installed release
[ -d "$BIN/../sdk" ] || [ ! -x "$ISIM_INSTALL_DIR/current/bin/isim-runtime" ] || BIN=$(cd -- "$ISIM_INSTALL_DIR/current/bin" && pwd)
SDK=${ISIM_SDK:-$BIN/../sdk}
DATA=$(realpath -m -- "${ISIM_DATA:-$HOME/.local/share/isim}")   # absolute: apps resolve paths under it
[ -z "${ISIM_DATA:-}" ] || export ISIM_DATA=$DATA
cmd=${1:-help}; shift || true
device_opts() {   # sets env from device options; leaves the rest in REST
  REST=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --device) export ISIM_DEVICE=$2; shift 2 ;;
      --os) export ISIM_OS_VERSION=$2; shift 2 ;;
      --zoom) export ISIM_ZOOM=$2; shift 2 ;;
      --control) export ISIM_CONTROL=$2; [ -p "$2" ] || mkfifo "$2"; shift 2 ;;
      --dark) export ISIM_APPEARANCE=dark; shift ;;
      --headless) export ISIM_HEADLESS=1; shift ;;
      --script) export ISIM_SCRIPT=$2; shift 2 ;;
      *) REST+=("$1"); shift ;;
    esac
  done
}
OSFILE=$DATA/Library/isim/os-version   # the device data's iOS version (written by --os / ISIM_OS_VERSION)
select_os() {   # validates the device + iOS version pairing; remembers an explicit choice in the device data
  if [ -n "${ISIM_OS_VERSION:-}" ]; then
    local v; v=$(ISIM_OS_DEFAULT= "$BIN/isim-runtime" --os-check) || exit 2
    export ISIM_OS_VERSION=$v
    mkdir -p "$(dirname "$OSFILE")"; printf '%s\n' "$v" > "$OSFILE"
  elif [ -f "$OSFILE" ]; then
    export ISIM_OS_DEFAULT; ISIM_OS_DEFAULT=$(cat "$OSFILE")
  fi
}
plist_get() { python3 -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1],"rb")).get(sys.argv[2],""))' "$1" "$2"; }
# The running device's control FIFO: every device reads script commands from one, --control FIFO or else a default
# FIFO of its own, and `$CTLREC` names it with the device's pid (this script execs the runtime, so the pid stays) for
# isim send / open / openurl.
CTLREC=$DATA/Library/isim/control
control_setup() {   # before exec'ing a device
  if [ -z "${ISIM_CONTROL:-}" ]; then
    local dir
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then dir=$XDG_RUNTIME_DIR/isim
    else dir=${TMPDIR:-/tmp}/isim-$(id -u); fi
    mkdir -p -m 700 "$dir" 2>/dev/null || true
    if [ -d "$dir" ] && [ -O "$dir" ] && [ ! -L "$dir" ]; then       # ours, not someone else's in a shared /tmp
      local f
      f=$dir/$(printf %s "$DATA" | sha256sum | cut -c1-16).ctl     # one per device data
      [ -p "$f" ] || { rm -f -- "$f"; mkfifo -m 600 -- "$f"; }
      export ISIM_CONTROL=$f ISIM_CONTROL_AUTO=1                   # the runtime removes it when it exits
    fi
  fi
  [ -n "${ISIM_CONTROL:-}" ] || return 0
  mkdir -p "$DATA/Library/isim"
  printf '%s\n%s\n' "$$" "$(realpath -m -- "$ISIM_CONTROL")" > "$CTLREC"
}
device_control() {  # prints the running device's control FIFO; fails when no device runs on this device data
  local pid fifo
  [ -f "$CTLREC" ] && { read -r pid && read -r fifo; } < "$CTLREC" || return 1
  [ -n "$pid" ] && [ "$(basename -- "$(readlink "/proc/$pid/exe" 2>/dev/null)")" = isim-runtime ] && [ -p "$fifo" ] || return 1
  printf '%s\n' "$fifo"
}
send_cmd() {        # send_cmd FIFO "commands": one line; bounded, so a FIFO nobody reads cannot hang us
  timeout 5 bash -c 'printf "%s\n" "$2" > "$1"' _ "$1" "$2" || { echo "isim: the device did not take the command (is it running?)" >&2; return 1; }
}
no_device() { echo "isim $1: no device is running on $DATA (start one with isim boot or isim run)" >&2; exit 1; }
# isim Simulator in the desktop's app launcher (freedesktop.org desktop entry, hicolor icons, a MIME type for .apns
# files), in $XDG_DATA_HOME (~/.local/share). install.sh / isim update run `desktop install` for the active release.
APP_ID=dev.isim.Simulator
desktop_cmd() {
  local share=${XDG_DATA_HOME:-$HOME/.local/share}
  local entry=$share/applications/$APP_ID.desktop mime=$share/mime/packages/$APP_ID.xml icons=$share/icons/hicolor
  case "$1" in
    install)
      local src=$BIN/../share/icons/hicolor exe
      [ -d "$src" ] || { echo "isim desktop: this isim has no icons ($src; build.py makes them)" >&2; exit 1; }
      # an installed release: through `current`, so isim update / isim use keep the entry working
      case "$BIN/" in
        "$(realpath -m -- "$ISIM_INSTALL_DIR")"/*/bin/) exe=$ISIM_INSTALL_DIR/current/bin/isim ;;
        *) exe=$BIN/isim ;;
      esac
      case "$exe" in *[\"\`\$\\%]*|*$'\n'*)
        echo "isim desktop: cannot write a desktop entry for a path with \", \`, \$, \\ or %: $exe" >&2; exit 1 ;; esac
      mkdir -p "$share/applications" "$share/mime/packages"
      local a actions=""
      for a in "iphone15 iPhone 15" "iphonese iPhone SE" "ipadair11 iPad Air 11″"; do
        actions+=$'\n'"[Desktop Action ${a%% *}]"$'\n'"Name=${a#* }"$'\n'"Exec=\"$exe\" open --device ${a%% *}"$'\n'
      done
      cat > "$entry.tmp" <<EOF
[Desktop Entry]
Type=Application
Version=1.5
Name=isim Simulator
GenericName=iOS-compatible Simulator
Comment=Run iOS apps on a simulated iPhone or iPad
Exec="$exe" open %f
TryExec=$exe
Icon=$APP_ID
Terminal=false
StartupNotify=false
StartupWMClass=$APP_ID
Categories=Development;
Keywords=iOS;iPhone;iPad;simulator;
MimeType=application/x-apns+json;
Actions=iphone15;iphonese;ipadair11;
$actions
EOF
      mv -f "$entry.tmp" "$entry"
      local f rel
      for f in "$src"/*/apps/$APP_ID.*; do
        rel=${f#"$src"/}; mkdir -p "$icons/$(dirname -- "$rel")"; cp -f -- "$f" "$icons/$rel"
      done
      cat > "$mime" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-apns+json">
    <comment>Push notification payload</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.apns"/>
  </mime-type>
</mime-info>
EOF
      desktop_caches "$share"
      echo "isim desktop: isim Simulator is in the app launcher ($entry)" ;;
    uninstall)
      rm -f -- "$entry" "$mime" "$icons"/*/apps/$APP_ID.png "$icons"/scalable/apps/$APP_ID.svg
      desktop_caches "$share"
      echo "isim desktop: removed isim Simulator from the app launcher" ;;
    *) echo "usage: isim desktop install|uninstall" >&2; exit 2 ;;
  esac
}
desktop_caches() {  # refresh the desktop's caches where the tools exist (not needed by every desktop)
  ! command -v update-desktop-database >/dev/null || update-desktop-database -q "$1/applications" 2>/dev/null || true
  ! command -v update-mime-database >/dev/null || update-mime-database "$1/mime" >/dev/null 2>&1 || true
  ! command -v gtk-update-icon-cache >/dev/null || gtk-update-icon-cache -q -f -t "$1/icons/hicolor" 2>/dev/null || true
}
case "$cmd" in
  version|--version|-v)
    echo "isim $(cat "$BIN/VERSION" 2>/dev/null || echo unknown)"
    echo "iOS versions: 17, 18 (default), 26, 27 (--os N; API level emulated by isim, not Apple's iOS)"
    [ -f "$OSFILE" ] && echo "device data $DATA: iOS $(cat "$OSFILE")"
    true ;;
  devices)
    "$BIN/isim-runtime" --list-devices
    if [ -f "$OSFILE" ]; then echo "device data $DATA: iOS $(cat "$OSFILE") (remembered from --os)"; else echo "device data $DATA: iOS 18.0 (default)"; fi ;;
  update|self-update)   # isim update [VERSION]: download and activate a release (install.sh)
    inst=$BIN/isim-install.sh
    if [ -f "$inst" ]; then exec bash "$inst" "$@"; fi
    exec bash -c "$(curl -fsSL "https://raw.githubusercontent.com/${ISIM_REPO:-kolabs-dev/isim}/main/install.sh")" isim-install "$@" ;;
  versions)             # installed releases, * = active
    cur=$(readlink "$ISIM_INSTALL_DIR/current" 2>/dev/null || true)
    found=0
    for d in "$ISIM_INSTALL_DIR"/*/; do
      [ -x "$d/bin/isim" ] || continue; v=$(basename "$d"); [ "$v" = current ] && continue; found=1
      if [ "$v" = "$cur" ]; then echo "* $v"; else echo "  $v"; fi
    done
    [ $found = 1 ] || echo "no releases installed in $ISIM_INSTALL_DIR (this is $(cat "$BIN/VERSION" 2>/dev/null || echo a development build) in $BIN)" ;;
  use)                  # isim use VERSION: make an installed release the active one
    v=${1:?usage: isim use VERSION}; v=${v#v}
    [ -x "$ISIM_INSTALL_DIR/$v/bin/isim" ] || { echo "isim: $v is not installed (isim versions; isim update $v)" >&2; exit 1; }
    ln -sfn "$v" "$ISIM_INSTALL_DIR/current"; echo "isim $v is active"
    if [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/applications/$APP_ID.desktop" ]; then   # keep the launcher entry right
      if [ -d "$ISIM_INSTALL_DIR/$v/share/icons" ]; then ISIM_INSTALL_DIR=$ISIM_INSTALL_DIR "$ISIM_INSTALL_DIR/$v/bin/isim" desktop install >/dev/null
      else desktop_cmd uninstall >/dev/null; echo "isim: $v has no desktop launcher; removed isim Simulator from the app launcher"; fi
    fi ;;
  boot)
    device_opts "$@"
    select_os
    control_setup
    mkdir -p "$DATA/Applications"
    export ISIM_DATA=$DATA ISIM_SYSTEM_APPS=$SDK/Applications ISIM_APPS=$DATA/Applications
    exec "$BIN/isim-runtime" --root "$SDK" --shell "$SDK/Applications/SpringBoard.app" "$SDK/Applications/SpringBoard.app/SpringBoard" ;;
  install)
    [ $# -gt 0 ] || { echo "usage: isim install <App.app>..." >&2; exit 2; }
    mkdir -p "$DATA/Applications"
    for app in "$@"; do
      [ -f "$app/Info.plist" ] || { echo "isim install: $app is not an app bundle" >&2; exit 1; }
      dst=$DATA/Applications/$(basename "$app")
      rm -rf "$dst"; cp -a "$app" "$dst"
      echo "installed $(plist_get "$app/Info.plist" CFBundleDisplayName || true) ($(plist_get "$app/Info.plist" CFBundleIdentifier)) -> $dst"
    done ;;
  uninstall)
    want=${1:?usage: isim uninstall <name|bundle id>}
    for app in "$DATA"/Applications/*.app; do
      [ -d "$app" ] || continue
      id=$(plist_get "$app/Info.plist" CFBundleIdentifier)
      if [ "$id" = "$want" ] || [ "$(basename "$app" .app)" = "$want" ] || [ "$(plist_get "$app/Info.plist" CFBundleDisplayName)" = "$want" ]; then
        rm -rf "$app" "$DATA/Containers/$id"; echo "uninstalled $id"; exit 0
      fi
    done
    echo "isim uninstall: '$want' is not installed" >&2; exit 1 ;;
  apps)
    for app in "$DATA"/Applications/*.app; do
      [ -d "$app" ] || continue
      printf '%-28s %-40s %s\n' "$(plist_get "$app/Info.plist" CFBundleDisplayName)" "$(plist_get "$app/Info.plist" CFBundleIdentifier)" "$app"
    done ;;
  reset)
    rm -rf "$DATA/Applications" "$DATA/Containers" "$DATA/Library" "$DATA/Shared"
    echo "erased the isim device at $DATA" ;;
  run)
    app=${1:?usage: isim run <App.app>}; shift
    while [ $# -gt 0 ]; do
      case "$1" in
        --device) export ISIM_DEVICE=$2; shift 2 ;;
        --os) export ISIM_OS_VERSION=$2; shift 2 ;;
        --zoom) export ISIM_ZOOM=$2; shift 2 ;;
      --control) export ISIM_CONTROL=$2; [ -p "$2" ] || mkfifo "$2"; shift 2 ;;
        --dark) export ISIM_APPEARANCE=dark; shift ;;
        --headless) export ISIM_HEADLESS=1; shift ;;
        --script) export ISIM_SCRIPT=$2; shift 2 ;;
        *) break ;;
      esac
    done
    select_os
    control_setup
    exe=$app
    if [ -d "$app" ]; then
      name=$(python3 -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1],"rb"))["CFBundleExecutable"])' "$app/Info.plist")
      exe=$app/$name
    fi
    if [ -d "$app" ] && [ -z "${ISIM_HEADLESS:-}" ] && [ -z "${ISIM_STANDALONE:-}" ]; then
      # like Xcode: install the app, boot the device and open the app over the home screen
      # (launch arguments apply to this launch; ISIM_STANDALONE=1 runs the app alone, without the home screen)
      mkdir -p "$DATA/Applications"
      dst=$DATA/Applications/$(basename "$app")
      if [ "$(readlink -f "$app")" != "$(readlink -f "$dst")" ]; then rm -rf "$dst"; cp -a "$app" "$dst"; fi
      export ISIM_DATA=$DATA ISIM_SYSTEM_APPS=$SDK/Applications ISIM_APPS=$DATA/Applications
      exec "$BIN/isim-runtime" --root "$SDK" --shell "$SDK/Applications/SpringBoard.app" "$SDK/Applications/SpringBoard.app/SpringBoard" \
        --open "$dst" "$dst/$name" "$@"
    fi
    exec "$BIN/isim-runtime" --root "$SDK" "$exe" "$@" ;;
  cc)
    # the linker flags only when clang links (not with -c, -S, -E, ...), so compiles do not warn about unused arguments
    link=(-fuse-ld=lld -L "$SDK/usr/lib/swift")
    for a in "$@"; do case "$a" in -c|-S|-E|-M|-MM|-fsyntax-only|--precompile) link=() ;; esac; done
    exec "${CLANG:-clang}" -target x86_64-apple-ios${ISIM_MIN_IOS:-17.0}-simulator -isysroot "$SDK" -fobjc-arc "${link[@]}" "$@" ;;
  swiftc)
    ws=$(cd -- "$BIN/../../.." && pwd)
    mounts=(-v "$ws:$ws")
    # also expose input files that live outside the isim workspace (e.g. an app project elsewhere), read-only
    declare -A seen=(["$ws"]=1)
    for a in "$@" "$PWD/"; do
      [[ "$a" == /* ]] || continue
      d=$a; [ -d "$d" ] || d=$(dirname -- "$a")
      [ -d "$d" ] || continue
      case "$d/" in "$ws"/*) continue ;; esac
      [ -n "${seen[$d]:-}" ] && continue; seen[$d]=1
      mounts+=(--mount "type=bind,src=$d,dst=$d,readonly")
    done
    run=(docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp "${mounts[@]}" -w "$PWD" swift:6.2 swiftc -target x86_64-apple-ios${ISIM_MIN_IOS:-17.0}-simulator)
    if [ "${1:-}" = "-embedded" ]; then
      shift
      exec "${run[@]}" -enable-experimental-feature Embedded -enable-experimental-feature Extern -wmo -parse-as-library -Osize \
        -I "$BIN/../swift/embedded" "$@"
    fi
    # full Swift: stdlib + runtime + Concurrency + _StringProcessing (Regex) from the isim SDK (/usr/lib/swift),
    # implicitly imported like Apple's toolchain does once they are built
    # isim's own resource dir (clang builtin headers + SwiftShims): keeps the Linux toolchain's corelibs
    # module maps (Dispatch, CoreFoundation for Linux) out of iOS builds
    # isim's macro plugins for the compiler's host (#Preview: PreviewsMacros), next to the toolchain's own
    plugins=(); [ -d "$BIN/../swift/host/plugins" ] && plugins=(-plugin-path "$BIN/../swift/host/plugins")
    exec "${run[@]}" -sdk "$SDK" -resource-dir "$BIN/../swift/resource" "${plugins[@]}" -O -runtime-compatibility-version none \
      $( [ -d "$SDK/usr/lib/swift/_Concurrency.swiftmodule" ] || echo -Xfrontend -disable-implicit-concurrency-module-import ) \
      $( [ -d "$SDK/usr/lib/swift/_StringProcessing.swiftmodule" ] || echo -Xfrontend -disable-implicit-string-processing-module-import ) "$@" ;;
  build)
    exec python3 "$BIN/isim-build.py" "$@" ;;
  push)      # isim push [BUNDLE_ID] payload.apns|-: queue a payload for the device's home screen (like `xcrun simctl push booted`)
    [ $# -ge 1 ] || { echo "usage: isim push [BUNDLE_ID] <payload.apns|->" >&2; exit 2; }
    if [ $# -ge 2 ]; then bundle=$1; src=$2; else bundle=; src=$1; fi
    q=$DATA/Library/isim/PushQueue; mkdir -p "$q"
    tmp=$(mktemp "$q/.incoming.XXXXXX")
    if [ "$src" = - ]; then cat > "$tmp"; else cp -- "$src" "$tmp" || { rm -f "$tmp"; exit 1; }; fi
    target=$(python3 - "$tmp" "$bundle" <<'PY'
import json, sys
try: p = json.load(open(sys.argv[1]))
except Exception as e: sys.exit("isim push: the payload is not JSON: %s" % e)
if not isinstance(p, dict) or not isinstance(p.get("aps"), dict): sys.exit('isim push: the payload needs an "aps" dictionary')
b = sys.argv[2] or p.get("Simulator Target Bundle") or ""
if not b: sys.exit('isim push: give a bundle identifier, or add "Simulator Target Bundle" to the payload')
print(b)
PY
) || { rm -f "$tmp"; exit 1; }
    mv "$tmp" "$q/$(date +%s%N)-$target.apns"
    if [ -f "$DATA/Library/isim/shell.pid" ] && kill -0 "$(cat "$DATA/Library/isim/shell.pid")" 2>/dev/null; then
      echo "isim push: sent to $target"
    else echo "isim push: queued for $target (no device is running; it is delivered when the device boots: isim boot)"; fi ;;
  openurl)   # isim openurl URL [--control FIFO]: open a URL in the running device (its FIFO, or the given one)
    url=${1:?usage: isim openurl <URL> [--control FIFO]}; shift
    [ "${1:-}" = "--control" ] && ISIM_CONTROL=$2
    if [ -p "${ISIM_CONTROL:-}" ]; then fifo=$ISIM_CONTROL; else fifo=$(device_control) || no_device openurl; fi
    send_cmd "$fifo" "openurl $url" ;;
  send)      # isim send COMMAND...: script commands to the running device of this device data
    [ $# -gt 0 ] || { echo 'usage: isim send COMMAND... (script commands, docs/SCRIPTING.md; e.g. isim send "home; shot s.png")' >&2; exit 2; }
    fifo=$(device_control) || no_device send
    send_cmd "$fifo" "$*" ;;
  open)      # isim open [device options] [FILE.apns]: the desktop launcher's entry point (isim desktop install)
    device_opts "$@"
    file=
    for a in "${REST[@]}"; do
      case "$a" in
        *.apns) file=$a ;;
        -*) echo "isim open: unknown option $a" >&2; exit 2 ;;
        *) echo "isim open: cannot open $a (only .apns push payloads)" >&2; exit 2 ;;
      esac
    done
    self=${BASH_SOURCE[0]}
    if fifo=$(device_control); then                   # already running: bring it to the front
      [ -z "$file" ] || "$self" push "$file"
      [ -z "${ISIM_DEVICE:-}${ISIM_OS_VERSION:-}" ] || echo "isim open: a device is already running on $DATA; quit it to start another device or iOS version" >&2
      send_cmd "$fifo" focus
      exit 0
    fi
    [ -z "$file" ] || "$self" push "$file"            # queued: delivered once the device boots
    exec "$self" boot ;;                              # (device options are in the environment now)
  desktop)   # isim desktop install|uninstall: isim Simulator in the desktop's app launcher (freedesktop.org entries)
    desktop_cmd "${1:-}" ;;
  test)
    exec python3 "$BIN/isim-test.py" "$@" ;;
  storekit|gamecenter|appleid)
    ISIM_DATA=$DATA exec python3 "$BIN/isim-services.py" "$cmd" "$@" ;;
  metrickit)   # Debug > Simulate MetricKit Payloads: running apps' MXMetricManager subscribers get sample payloads
    mkdir -p "$DATA/Library/isim"; date +%s.%N > "$DATA/Library/isim/MetricKitTrigger"
    echo "isim: simulated MetricKit payloads requested (apps with a subscriber get them within 0.5 s)" ;;
  info)
    f=${1:?usage: isim info <App.app|binary>}
    [ -d "$f" ] && f=$f/$(python3 -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1],"rb"))["CFBundleExecutable"])' "$f/Info.plist")
    llvm-objdump --macho --private-headers "$f" | grep -A4 LC_BUILD_VERSION | grep -E 'platform|minos|sdk'
    llvm-otool -L "$f" | tail -n +2 ;;
  *) sed -n '2,/^set -euo/{/^set -euo/!p}' "${BASH_SOURCE[0]}" ;;
esac
