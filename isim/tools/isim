#!/usr/bin/env bash
# isim — iOS simulator for Linux (research prototype).
#   isim boot [device options]   start the simulated device on its home screen (installed apps + Settings)
#   isim install <App.app>...    install apps on the device (shown on the home screen)
#   isim uninstall <name|bundle id>   remove an installed app (and its data container)
#   isim apps                    list installed apps
#   isim reset                   erase the device: installed apps, app data and settings
#   isim run <App.app> [args...]: install, boot and open the app (headless or ISIM_STANDALONE=1: the app alone)
#     options: [--device iphonese|iphone13mini|iphone14|iphone15|iphone15plus|iphone15promax|iphone16pro|iphone16promax|iphone17|iphoneair|iphone17pro|iphone17promax|ipadmini|ipadair11|ipadpro11|ipadpro13] [--zoom N] [--dark] [--headless --script "..."]
#   isim cc  <clang args...>     compile/link for the isim iOS-simulator SDK (x86_64)
#   isim swiftc [-embedded] <swiftc args...>  compile Swift for the simulator (needs docker image swift:6.2)
#   ISIM_MIN_IOS=17.0            deployment target used by cc/swiftc (default 17.0)
#   isim build -project X.xcodeproj [-target T] [-configuration Debug]   build an Xcode project for isim
#   isim info <App.app|binary>   show Mach-O platform / dependencies
#   isim storekit <app> list|refund|expire|cancel|resume|clear ...   local StoreKit Transaction Manager
#   isim gamecenter <app> saved-games|conflict|reset ...              local Game Center data
#   isim openurl <URL> [--control FIFO]   open a URL (custom scheme or universal link) in the running device's foreground app
#   isim appleid <app> list|revoke|reset         local Sign in with Apple state (revoke = Stop Using Apple ID)
#   isim metrickit               deliver sample MetricKit payloads to running apps (Debug > Simulate MetricKit Payloads)
#   isim version                                                      print the isim version
#   device options: --device NAME --zoom N --dark --headless --script "..." --control FIFO (live script commands, one per line); device data: ISIM_DATA (~/.local/share/isim)
set -euo pipefail
BIN=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
SDK=${ISIM_SDK:-$BIN/../sdk}
DATA=${ISIM_DATA:-$HOME/.local/share/isim}
cmd=${1:-help}; shift || true
device_opts() {   # sets env from device options; leaves the rest in REST
  REST=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --device) export ISIM_DEVICE=$2; shift 2 ;;
      --zoom) export ISIM_ZOOM=$2; shift 2 ;;
      --control) export ISIM_CONTROL=$2; [ -p "$2" ] || mkfifo "$2"; shift 2 ;;
      --dark) export ISIM_APPEARANCE=dark; shift ;;
      --headless) export ISIM_HEADLESS=1; shift ;;
      --script) export ISIM_SCRIPT=$2; shift 2 ;;
      *) REST+=("$1"); shift ;;
    esac
  done
}
plist_get() { python3 -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1],"rb")).get(sys.argv[2],""))' "$1" "$2"; }
case "$cmd" in
  version|--version|-v)
    echo "isim $(cat "$BIN/VERSION" 2>/dev/null || echo unknown)" ;;
  boot)
    device_opts "$@"
    mkdir -p "$DATA/Applications"
    export ISIM_DATA=$DATA ISIM_SYSTEM_APPS=$SDK/Applications ISIM_APPS=$DATA/Applications
    exec "$BIN/isim-runtime" --root "$SDK" --shell "$SDK/Applications/SpringBoard.app" "$SDK/Applications/SpringBoard.app/SpringBoard" ;;
  install)
    [ $# -gt 0 ] || { echo "usage: isim install <App.app>..." >&2; exit 2; }
    mkdir -p "$DATA/Applications"
    for app in "$@"; do
      [ -f "$app/Info.plist" ] || { echo "isim install: $app is not an app bundle" >&2; exit 1; }
      dst=$DATA/Applications/$(basename "$app")
      rm -rf "$dst"; cp -a "$app" "$dst"
      echo "installed $(plist_get "$app/Info.plist" CFBundleDisplayName || true) ($(plist_get "$app/Info.plist" CFBundleIdentifier)) -> $dst"
    done ;;
  uninstall)
    want=${1:?usage: isim uninstall <name|bundle id>}
    for app in "$DATA"/Applications/*.app; do
      [ -d "$app" ] || continue
      id=$(plist_get "$app/Info.plist" CFBundleIdentifier)
      if [ "$id" = "$want" ] || [ "$(basename "$app" .app)" = "$want" ] || [ "$(plist_get "$app/Info.plist" CFBundleDisplayName)" = "$want" ]; then
        rm -rf "$app" "$DATA/Containers/$id"; echo "uninstalled $id"; exit 0
      fi
    done
    echo "isim uninstall: '$want' is not installed" >&2; exit 1 ;;
  apps)
    for app in "$DATA"/Applications/*.app; do
      [ -d "$app" ] || continue
      printf '%-28s %-40s %s\n' "$(plist_get "$app/Info.plist" CFBundleDisplayName)" "$(plist_get "$app/Info.plist" CFBundleIdentifier)" "$app"
    done ;;
  reset)
    rm -rf "$DATA/Applications" "$DATA/Containers" "$DATA/Library" "$DATA/Shared"
    echo "erased the isim device at $DATA" ;;
  run)
    app=${1:?usage: isim run <App.app>}; shift
    while [ $# -gt 0 ]; do
      case "$1" in
        --device) export ISIM_DEVICE=$2; shift 2 ;;
        --zoom) export ISIM_ZOOM=$2; shift 2 ;;
      --control) export ISIM_CONTROL=$2; [ -p "$2" ] || mkfifo "$2"; shift 2 ;;
        --dark) export ISIM_APPEARANCE=dark; shift ;;
        --headless) export ISIM_HEADLESS=1; shift ;;
        --script) export ISIM_SCRIPT=$2; shift 2 ;;
        *) break ;;
      esac
    done
    exe=$app
    if [ -d "$app" ]; then
      name=$(python3 -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1],"rb"))["CFBundleExecutable"])' "$app/Info.plist")
      exe=$app/$name
    fi
    if [ -d "$app" ] && [ -z "${ISIM_HEADLESS:-}" ] && [ -z "${ISIM_STANDALONE:-}" ]; then
      # like Xcode: install the app, boot the device and open the app over the home screen
      # (launch arguments apply to this launch; ISIM_STANDALONE=1 runs the app alone, without the home screen)
      mkdir -p "$DATA/Applications"
      dst=$DATA/Applications/$(basename "$app")
      if [ "$(readlink -f "$app")" != "$(readlink -f "$dst")" ]; then rm -rf "$dst"; cp -a "$app" "$dst"; fi
      export ISIM_DATA=$DATA ISIM_SYSTEM_APPS=$SDK/Applications ISIM_APPS=$DATA/Applications
      exec "$BIN/isim-runtime" --root "$SDK" --shell "$SDK/Applications/SpringBoard.app" "$SDK/Applications/SpringBoard.app/SpringBoard" \
        --open "$dst" "$dst/$name" "$@"
    fi
    exec "$BIN/isim-runtime" --root "$SDK" "$exe" "$@" ;;
  cc)
    exec "${CLANG:-clang}" -target x86_64-apple-ios${ISIM_MIN_IOS:-17.0}-simulator -isysroot "$SDK" -fuse-ld=lld -fobjc-arc -L "$SDK/usr/lib/swift" "$@" ;;
  swiftc)
    ws=$(cd -- "$BIN/../../.." && pwd)
    mounts=(-v "$ws:$ws")
    # also expose input files that live outside the isim workspace (e.g. an app project elsewhere), read-only
    declare -A seen=(["$ws"]=1)
    for a in "$@" "$PWD/"; do
      [[ "$a" == /* ]] || continue
      d=$a; [ -d "$d" ] || d=$(dirname -- "$a")
      [ -d "$d" ] || continue
      case "$d/" in "$ws"/*) continue ;; esac
      [ -n "${seen[$d]:-}" ] && continue; seen[$d]=1
      mounts+=(--mount "type=bind,src=$d,dst=$d,readonly")
    done
    run=(docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp "${mounts[@]}" -w "$PWD" swift:6.2 swiftc -target x86_64-apple-ios${ISIM_MIN_IOS:-17.0}-simulator)
    if [ "${1:-}" = "-embedded" ]; then
      shift
      exec "${run[@]}" -enable-experimental-feature Embedded -enable-experimental-feature Extern -wmo -parse-as-library -Osize \
        -I "$BIN/../swift/embedded" "$@"
    fi
    # full Swift: stdlib + runtime + Concurrency + _StringProcessing (Regex) from the isim SDK (/usr/lib/swift),
    # implicitly imported like Apple's toolchain does once they are built
    # isim's own resource dir (clang builtin headers + SwiftShims): keeps the Linux toolchain's corelibs
    # module maps (Dispatch, CoreFoundation for Linux) out of iOS builds
    exec "${run[@]}" -sdk "$SDK" -resource-dir "$BIN/../swift/resource" -O -runtime-compatibility-version none \
      $( [ -d "$SDK/usr/lib/swift/_Concurrency.swiftmodule" ] || echo -Xfrontend -disable-implicit-concurrency-module-import ) \
      $( [ -d "$SDK/usr/lib/swift/_StringProcessing.swiftmodule" ] || echo -Xfrontend -disable-implicit-string-processing-module-import ) "$@" ;;
  build)
    exec python3 "$BIN/isim-build.py" "$@" ;;
  openurl)   # isim openurl URL [--control FIFO]: open a URL in the foreground app of a device started with --control FIFO
    url=${1:?usage: isim openurl <URL> [--control FIFO]}; shift
    [ "${1:-}" = "--control" ] && ISIM_CONTROL=$2
    [ -p "${ISIM_CONTROL:-}" ] || { echo "isim openurl: start the device with --control FIFO (or set ISIM_CONTROL) to send it URLs" >&2; exit 2; }
    printf 'openurl %s\n' "$url" > "$ISIM_CONTROL" ;;
  storekit|gamecenter|appleid)
    ISIM_DATA=$DATA exec python3 "$BIN/isim-services.py" "$cmd" "$@" ;;
  metrickit)   # Debug > Simulate MetricKit Payloads: running apps' MXMetricManager subscribers get sample payloads
    mkdir -p "$DATA/Library/isim"; date +%s.%N > "$DATA/Library/isim/MetricKitTrigger"
    echo "isim: simulated MetricKit payloads requested (apps with a subscriber get them within 0.5 s)" ;;
  info)
    f=${1:?usage: isim info <App.app|binary>}
    [ -d "$f" ] && f=$f/$(python3 -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1],"rb"))["CFBundleExecutable"])' "$f/Info.plist")
    llvm-objdump --macho --private-headers "$f" | grep -A4 LC_BUILD_VERSION | grep -E 'platform|minos|sdk'
    llvm-otool -L "$f" | tail -n +2 ;;
  *) sed -n '2,21p' "$0" ;;
esac
